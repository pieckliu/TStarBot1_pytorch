diff --git a/pysc2/lib/colors.py b/pysc2/lib/colors.py
--- a/pysc2/lib/colors.py
+++ b/pysc2/lib/colors.py
@@ -125,4 +125,8 @@ def shuffled_hue(scale):
 def shuffled_hue(scale):
   palette = list(smooth_hue_palette(scale))
-  random.shuffle(palette, lambda: 0.5)  # Return a fixed shuffle
+  # Python 3.11 removed random.shuffle's custom RNG argument. Reproduce the
+  # old constant-0.5 Fisher-Yates shuffle exactly to preserve palette values.
+  for i in range(len(palette) - 1, 0, -1):
+    j = int(0.5 * (i + 1))
+    palette[i], palette[j] = palette[j], palette[i]
   return numpy.array(palette)
